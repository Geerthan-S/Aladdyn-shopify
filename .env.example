# Public browser-safe configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public Shopify App Store listing used after the app is published.
SHOPIFY_APP_STORE_URL=
# Draft testing only: the development store that should receive the install.
# Example: your-development-store.myshopify.com
SHOPIFY_TEST_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders,read_discounts

# Shopify UCP agent credentials. Required for Checkout MCP; catalog and cart
# remain available at Shopify's unauthenticated tier.
SHOPIFY_UCP_CLIENT_ID=
SHOPIFY_UCP_CLIENT_SECRET=
ALADDYN_UCP_PROFILE_URL=https://aladdyn-app.vercel.app/.well-known/ucp

# Base64-encoded 32-byte random value.
# Generate one locally without printing it to shell history:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_TOKEN_ENCRYPTION_KEY_VERSION=1

# Operational settings.
SHOPIFY_REQUEST_TIMEOUT_MS=15000
DATA_INSPECTOR_PAGE_SIZE=25
OAUTH_STATE_TTL_SECONDS=600
